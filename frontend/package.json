{
  "name": "service-monitor-frontend",
  "version": "0.0.0",
  "description": "React and Blueprint panels for the service-monitor-backend plugin: the logs of every process by topic and level, the processes, the machine and the health checks.",
  "keywords": [
    "blueprintjs",
    "logs",
    "monitoring",
    "react"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./styles.css": "./styles/monitor.css"
  },
  "files": [
    "lib",
    "src",
    "styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "prepack": "npm run tsc",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-cheminfo": ">=0.51.0 <1"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/icons": "^6.14.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@zakodium/tsconfig": "^1.0.5",
    "react": "^19.3.1",
    "react-cheminfo": "^0.58.0",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/service-monitor.git",
    "directory": "frontend"
  }
}
