{
  "name": "service-accounts-frontend",
  "version": "0.4.0",
  "description": "React and Blueprint pages for the service-accounts-backend routes: the sign-in form and dialog, a gate by role, the administrators' Accounts page, and the account menu of the bar, in react-cheminfo's languages.",
  "keywords": [
    "accounts",
    "blueprintjs",
    "react",
    "sign-in"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./session": "./lib/session.js",
    "./styles.css": "./styles/accounts.css"
  },
  "files": [
    "lib",
    "src",
    "styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "prepack": "npm run tsc",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "peerDependencies": {
    "@blueprintjs/core": "^6.0.0",
    "@blueprintjs/icons": "^6.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-cheminfo": ">=0.71.0 <1"
  },
  "peerDependenciesMeta": {
    "react-cheminfo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/icons": "^6.14.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@zakodium/tsconfig": "^1.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-cheminfo": "^0.71.0",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/service-monitor.git",
    "directory": "accounts-frontend"
  }
}
