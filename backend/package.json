{
  "name": "service-monitor-backend",
  "version": "0.0.0",
  "description": "One SQLite store for what every process of a service logs, by topic and level, and how each process and the machine are doing; a pino destination, a heartbeat, and a Fastify plugin that reads it.",
  "keywords": [
    "fastify",
    "logs",
    "monitoring",
    "pino",
    "sqlite"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "prepack": "npm run tsc",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "postgrator": "^8.0.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@zakodium/tsconfig": "^1.0.5",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/service-monitor.git",
    "directory": "backend"
  }
}
